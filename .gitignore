# ==============================================================================
# .gitignore for Xilinx Vivado Zynq-7020 CNN Accelerator Project
# ==============================================================================

# Vivado temporary runs, caches and hardware manager working files
*.cache/
*.hw/
*.ip_user_files/
*.sim/
.Xil/

# Vivado temporary logs and journals
*.log
*.jou
*.str
*.dmp
hs_err_pid*.log

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Python caches
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Explicitly ensure critical files are NEVER ignored
!*.xpr
!*.bd
!*.bxml
!*.xdc
!*.v
!*.vhd
!*.sv
!*.tcl
!*.bit
!*.hwh
!*.rpt
!*.md
!component.xml
