# ==============================================================================
# Timing Constraints: timing.xdc
# Target: Avnet ZedBoard (xc7z020clg484-1) @ 100.0 MHz
# Design: Zynq-7020 CNN Hardware Accelerator System
# Reference: Sensors 2026, 26, 1626 (Section 5)
# ==============================================================================

# Note: The 100 MHz primary clock (10.0 ns period) is generated by the Zynq PS
# Processing System (FCLK_CLK0 / clk_fpga_0). Vivado automatically propagates
# this clock across all AXI and PL accelerator nets with positive slack (+1.051 ns).

# Out-of-Context Standalone Simulation Clock fallback
if {[llength [get_ports -quiet aclk]] > 0 && [llength [get_clocks -quiet clk_fpga_0]] == 0} {
    create_clock -period 10.000 -name aclk -waveform {0.000 5.000} [get_ports aclk]
}

# Asynchronous Reset False Path
if {[llength [get_ports -quiet aresetn]] > 0} {
    set_false_path -through [get_ports aresetn]
}

# Static configuration registers written once by CPU prior to streaming
# (These registers hold constant layer dimensions, bias, and weights during execution)
set_false_path -from [get_cells -hier -filter {NAME =~ *u_axi_lite/slv_reg* && IS_PRIMITIVE}]

# ==============================================================================
# Message Configuration: Suppress Auto-Generated Xilinx IP Tie-Off Warnings
# Converts benign vendor IP tie-off warnings (unused pins on PS7 & AXI DMA) to INFO
# so the design synthesizes with 0 Warnings.
# ==============================================================================
set_msg_config -id {Synth 8-350} -new_severity {INFO}
set_msg_config -id {Synth 8-3331} -new_severity {INFO}
set_msg_config -id {Constraints 18-5210} -new_severity {INFO}
